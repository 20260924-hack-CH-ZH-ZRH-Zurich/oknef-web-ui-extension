{
  "name": "oknef-web-ui-extension",
  "version": "0.4.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run build:extension && next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "build:extension": "bun scripts/build-extension.mjs && bun scripts/verify-extension.mjs",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "audit": "bun audit --audit-level=high",
    "secret-scan": "gitleaks dir . --redact --no-banner"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@noble/post-quantum": "0.7.1",
    "clsx": "2.1.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "lucide-react": "1.48.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
